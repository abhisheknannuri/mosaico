# Build from the repository root:
#   docker build -f docker/dockerfiles/Dockerfile.mosaico-dashboard -t mosaico-dashboard:local .

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

ARG POETRY_VERSION=2.5.1

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

RUN python -m venv /opt/poetry && /opt/poetry/bin/pip install "poetry==${POETRY_VERSION}"

RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# Dashboard dependencies
WORKDIR /build/mosaico-dashboard
COPY mosaico-dashboard/pyproject.toml mosaico-dashboard/poetry.lock mosaico-dashboard/poetry.toml ./
RUN /opt/poetry/bin/poetry install --only main --no-root

# Mosaico SDK
COPY mosaico-sdk-py/pyproject.toml mosaico-sdk-py/README.md /build/mosaico-sdk-py/
COPY mosaico-sdk-py/src /build/mosaico-sdk-py/src
RUN pip install /build/mosaico-sdk-py

# Dashboard package
COPY mosaico-dashboard/README.md ./
COPY mosaico-dashboard/src ./src
RUN pip install --no-deps . && pip check

FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system --gid 10001 dashboard \
    && useradd --system --uid 10001 --gid dashboard --no-create-home dashboard

COPY --from=builder /opt/venv /opt/venv

USER dashboard
WORKDIR /app
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=2).status == 200 else 1)"]

CMD ["uvicorn", "mosaico_dashboard.main:app", "--host", "0.0.0.0", "--port", "8000"]
