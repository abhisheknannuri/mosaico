# Copy to .env and adjust. All variables are optional; values below are the defaults
# unless marked "dev".

# Web server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
# dev: restart on code changes
DASHBOARD_RELOAD=true

# Logging
DASHBOARD_LOG_LEVEL=INFO
# plain or pretty (dev: Rich colours in the terminal)
DASHBOARD_LOG_FORMAT=pretty

# Dashboard database (compose service dashboard-db)
DASHBOARD_DATABASE_URL=postgresql+psycopg://dashboard:dashboard@localhost:5433/dashboard
DASHBOARD_MIGRATE_ON_START=true

# Worker: seconds between checks for queued jobs
DASHBOARD_WORKER_POLL_SECONDS=1.0

# Folder on this machine with the ROS bags to ingest (.mcap, .db3, .bag)
DASHBOARD_INGEST_DIR=/absolute/path/to/bags
# Defaults of the advanced options: ROS distribution (empty = from the bag), keep partial data
DASHBOARD_INGEST_ROS_DISTRO=
DASHBOARD_INGEST_KEEP_PARTIAL=false

# mosaicod connection
DASHBOARD_MOSAICO_HOST=localhost
DASHBOARD_MOSAICO_PORT=6726
# DASHBOARD_MOSAICO_API_KEY=
DASHBOARD_MOSAICO_TLS=false
# DASHBOARD_MOSAICO_TLS_CERT_PATH=
# seconds to wait for mosaicod when connecting
DASHBOARD_MOSAICO_CONNECT_TIMEOUT=2
